#!/bin/sh
# выкатка mediasorter из раннера Forgejo (sudo без пароля только на этот скрипт): сборка образа, перезапуск; не поднялся - откат.
# Копия в репо: deploy/mediasorter-deploy, на pillow - /usr/local/sbin/mediasorter-deploy (ставить руками)
set -eu
src=/var/lib/forgejo-runner/deploy-mediasorter
app=/home/ishpagin/photosorter # compose и личный конфиг, исходников там нет
img=mediasorter:gpu

# BuildKit: слои и cache mounts (go, npm) переживают сборки, пересобирается только изменённое
docker buildx build --load -q -t mediasorter:new \
	--build-arg BASE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04 --build-arg ORT=onnxruntime-linux-x64-gpu-1.24.4 "$src"
docker image inspect $img >/dev/null 2>&1 && docker tag $img mediasorter:prev
docker tag mediasorter:new $img
docker rmi -f mediasorter:new >/dev/null
cd $app
docker compose up -d

for i in $(seq 30); do
	curl -fsS -o /dev/null http://127.0.0.1:8501/ && break
	sleep 2
done
if ! curl -fsS -o /dev/null http://127.0.0.1:8501/; then
	echo "mediasorter не поднялся, откат" >&2
	docker image inspect mediasorter:prev >/dev/null 2>&1 && docker tag mediasorter:prev $img && docker compose up -d
	exit 1
fi
docker image prune -f >/dev/null # старые безымянные образы после перетегивания
docker builder prune -f --max-used-space 20gb >/dev/null # кеш сборки не больше 20 ГБ
