# Настройки Mediasorter. Папку с фото start.bat / start.command / start.sh спрашивают сами (окном выбора папки).

# 1. Папка с твоими фото и видео (подпапки тоже). Пиши через прямые слэши /
#    Windows:  PHOTOS=C:/Users/Ivan/Pictures       или другой диск: PHOTOS=D:/Фото
#    macOS:    PHOTOS=/Users/ivan/Pictures
#    Linux:    PHOTOS=/home/ivan/Pictures
#    NAS, уже подключённый на Linux/macOS:  PHOTOS=/mnt/nas/photo   (или /Volumes/photo на Mac)
PHOTOS=

# 2. Только для NAS: если хочешь брать фото прямо с сетевой папки (SMB), заполни все три строки.
#    Тогда PHOTOS не используется. Пароль без запятых.
#    Пример: NAS_SHARE=//192.168.1.10/photo   (или //192.168.1.10/home/Photos — папка внутри шары)
NAS_SHARE=
NAS_USER=
NAS_PASSWORD=

# Куда складывать подборки (то, что отбираешь, чтобы отправить людям)
COLLECTIONS=./collections

# В котором часу ночью искать новые фото (и сразу после запуска, если давно не искали или папка сменилась)
SCAN_HOUR=3

# Адрес интерфейса: http://localhost:8501 (поменяй, если порт занят)
PORT=8501
